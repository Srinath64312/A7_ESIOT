# AI-MotorGuard Environment Configuration
# Copy this file to .env and update values

# Database
DATABASE_URL=postgresql://motorguard:motorguard_secret@localhost:5432/motorguard_db
POSTGRES_USER=motorguard
POSTGRES_PASSWORD=motorguard_secret
POSTGRES_DB=motorguard_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-random-secret-key

# AI Models
AI_MODEL_DIR=../ai/models
AI_MODEL_VERSION=1.0.0

# Simulation
SIMULATION_INTERVAL_MS=1000
DEFAULT_TARGET_RPM=1500

# Serial/UART (for hardware mode)
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200

# CAN Interface (for hardware mode)
CAN_INTERFACE=socketcan
CAN_CHANNEL=can0
CAN_BITRATE=500000

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
